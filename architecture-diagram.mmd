
flowchart LR
  %% Local-first Offline Sync Architecture (Vue + Pinia + Capacitor + SQLite)

  subgraph API["Backend"]
    Server["Backend API"]
    Http["API Client\n(fetch)"]
    Incremental["Incremental API\n(batch, since timestamp)"]
  end

  subgraph Sync["Sync Layer"]
    Net["Network Monitor\n(CapacitorConnectivityAdapter)"]
    Coordinator["OnlineOfflineCoordinator\n(connectivity → sync)"]
    SyncEngine["Sync Engine\n(drain outbox, pull updates)"]
    Conflict["Conflict Resolver\n(last-write-wins)"]
    Retry["Retry Utils\n(exponential backoff)"]
  end

  subgraph Storage["Offline Storage"]
    SQLite["SQLite DB\n(Capacitor)"]
    TodosTable["Todos Table\n(synced flag = outbox)"]
    SyncMeta["Sync Metadata Table\n(last sync, state, errors)"]
  end

  subgraph Domain["Domain Layer"]
    UseCases["Use Cases / Services\n(business rules)"]
    Repo["Repositories\n(typed data access)"]
    Cleanup["Data Cleanup Service\n(TTL enforcement)"]
    Policies["Data Policies Config\n(offline-first, online-only,\nretention days)"]
  end

  subgraph State["State Layer"]
    Pinia["Pinia Stores\n(UI reactive state)"]
  end

  subgraph UI["Vue UI"]
    VComp["Vue Components"]
  end

  %% Sync orchestration (top to bottom)
  Net -->|online/offline events| Coordinator
  Coordinator -->|triggers| SyncEngine
  Policies -->|which tables to sync| SyncEngine
  SyncEngine -->|read unsynced| TodosTable
  SyncEngine -->|read/write| SyncMeta
  SyncEngine -->|API calls| Http
  Http --> Incremental
  Incremental --> Server
  Server -->|remote changes| Incremental
  Incremental --> Http
  Http -->|apply changes| SyncEngine
  SyncEngine -->|conflict resolution| Conflict
  SyncEngine -->|retry logic| Retry
  SyncEngine -->|merge results| Repo

  %% Domain -> Storage (single source of truth)
  Repo -->|read/write| SQLite
  SQLite --> TodosTable
  SQLite --> SyncMeta
  Policies -->|retention policies| Cleanup
  Cleanup -->|TTL cleanup| SQLite

  %% UI -> State -> Domain (bottom flow)
  VComp -->|actions / intents| Pinia
  Pinia -->|calls| UseCases
  UseCases -->|CRUD| Repo
  UseCases -->|cleanup| Cleanup

  %% Reactivity direction: DB -> Store -> UI (bottom flow)
  SQLite -->|query results| Repo
  Repo -->|hydrates / refreshes| Pinia
  Pinia -->|reactive bindings| VComp

