
flowchart TB
  subgraph External["External Dependencies"]
    DomainPorts["Domain Ports\n(sync.port, connectivity.port)"]
    DataPolicies["Data Policies Config\n(which tables to sync)"]
    DomainServices["Domain Services\n(mergeRemoteTodo)"]
  end

  subgraph Connectivity["Connectivity Layer"]
    NetworkAPI["Capacitor Network API"]
    CapacitorAdapter["CapacitorConnectivityAdapter\n(implements ConnectivityPort)"]
  end

  subgraph Coordination["Coordination Layer"]
    Coordinator["OnlineOfflineCoordinator\n(domain/services/)"]
  end

  subgraph SyncOrchestration["Sync Orchestration"]
    SyncManager["SyncManager\n(manages multiple tables)"]
    SyncEngine["SyncEngine\n(implements SyncPort)"]
  end

  subgraph SyncComponents["Sync Components"]
    RetryUtils["Retry Utils\n(exponential backoff)"]
    ConflictResolver["Conflict Resolver\n(last-write-wins)"]
  end

  subgraph DataFlow["Data Flow"]
    Outbox["Outbox Pattern\n(synced flag in tables)"]
    SyncMetadata["Sync Metadata\n(last sync timestamp)"]
    API["API Clients\n(todos, todos-incremental)"]
    Repo["Repositories\n(todos repo)"]
  end

  NetworkAPI -->|network status| CapacitorAdapter
  DomainPorts -->|ConnectivityPort interface| CapacitorAdapter
  CapacitorAdapter -->|connectivity state| Coordinator
  DomainPorts -->|SyncPort interface| Coordinator

  Coordinator -->|triggers sync| SyncManager
  DataPolicies -->|which tables to sync| SyncManager
  SyncManager -->|creates/manages| SyncEngine

  SyncEngine -->|uses retry| RetryUtils
  SyncEngine -->|uses resolver| ConflictResolver
  SyncEngine -->|reads policies| DataPolicies

  Outbox -->|read unsynced| SyncEngine
  SyncEngine -->|push changes| API
  API -->|success| SyncEngine
  SyncEngine -->|mark synced| Outbox

  Outbox -->|read deleted| SyncEngine
  SyncEngine -->|delete from API| API
  API -->|success| SyncEngine
  SyncEngine -->|permanent delete| Outbox

  SyncMetadata -->|last sync timestamp| SyncEngine
  SyncEngine -->|fetch changes| API
  API -->|remote changes| SyncEngine
  SyncEngine -->|resolve conflicts| ConflictResolver
  ConflictResolver -->|resolved data| SyncEngine
  SyncEngine -->|merge| DomainServices
  DomainServices -->|upsert| Repo
  Repo -->|write| Outbox
  SyncEngine -->|update timestamp| SyncMetadata

  classDef syncComponent fill:#e1f5ff
  classDef dataFlow fill:#fff4e1
  classDef external fill:#f0f0f0

  class SyncEngine,RetryUtils,ConflictResolver syncComponent
  class Outbox,SyncMetadata,API,Repo dataFlow
  class DomainPorts,DataPolicies,DomainServices external

